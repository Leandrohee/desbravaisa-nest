generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  cod_user  Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  email     String   @unique
  hash      String
  firstName String
  lastName  String?

  // Relation to User_refresh_token
  refreshTokens User_refresh_token[]
}

model User_refresh_token {
  cod_user_refresh_token Int      @id @default(autoincrement())
  cod_user               Int
  refresh_token          String
  createdAt              DateTime @default(now())

  // Foreign key relationship
  user User @relation(fields: [cod_user], references: [cod_user])
}
